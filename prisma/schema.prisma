generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WorkoutGoal {
  STRENGTH
  HYPERTROPHY
  ENDURANCE
  MAINTENANCE
  WEIGHT_LOSS
}

enum TrainingLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum PlanStatus {
  ACTIVE
  ARCHIVED
}

enum MuscleRole {
  PRIMARY
  SECONDARY
  STABILIZER
}

enum Preference {
  LIKE
  DISLIKE
  AVOID
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  password      String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  refreshTokens RefreshToken[]
  summaries     AnalyticsSummary[]
  metricEvents  MetricEvent[]
  workoutPlans  WorkoutPlan[]
  bodyMetrics   BodyMetric[]
  
  // Profile Fields
  name          String?  // Preferred name
  gender        String?
  age           Int?
  height        Float?   // cm
  weight        Float?   // kg
  goalWeight    Float?   // kg
  goal          WorkoutGoal?
  trainingLevel TrainingLevel?

  activityLevel String?
  profileImage  String?
  
  // Preferences & Lifestyle
  equipment     String[] 
  workoutDays   String[] 
  sleepHours    Float?
  waterIntake   Float?   // liters

  @@index([email])
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Exercise {
  id                                                                  String                  @id @default(uuid())
  name                                                                String
  type                                                                String
  difficultyMin                                                       Int?
  difficultyMax                                                       Int?
  restMin                                                             Float?
  restMax                                                             Float?
  defaultSets                                                         Int?
  defaultReps                                                         String?
  loadFormula                                                         String?
  categoryId                                                          String?
  splitId                                                             String?
  movementPatternId                                                   String?
  createdAt                                                           DateTime                @default(now())
  updatedAt                                                           DateTime                @updatedAt
  externalId                                                          String?                 @unique
  gifUrl                                                              String?
  instructions                                                        String[]
  category                                                            Category?               @relation(fields: [categoryId], references: [id])
  movementPattern                                                     MovementPattern?        @relation(fields: [movementPatternId], references: [id])
  split                                                               Split?                  @relation(fields: [splitId], references: [id])
  equipment                                                           ExerciseEquipment[]
  muscles                                                             ExerciseMuscle[]
  ExerciseTag                                                         ExerciseTag[]
  ExerciseToAlternative_ExerciseToAlternative_alternativeIdToExercise ExerciseToAlternative[] @relation("ExerciseToAlternative_alternativeIdToExercise")
  ExerciseToAlternative_ExerciseToAlternative_exerciseIdToExercise    ExerciseToAlternative[] @relation("ExerciseToAlternative_exerciseIdToExercise")
  workoutExercises                                                   WorkoutExercise[]

  @@index([categoryId, splitId])
  @@index([name])
}

model Category {
  id        String     @id @default(uuid())
  name      String     @unique
  exercises Exercise[]
}

model Split {
  id        String     @id @default(uuid())
  name      String     @unique
  exercises Exercise[]
}

model MovementPattern {
  id        String     @id @default(uuid())
  name      String     @unique
  exercises Exercise[]
}

model Equipment {
  id        String              @id @default(uuid())
  name      String              @unique
  exercises ExerciseEquipment[]
}

model ExerciseEquipment {
  exerciseId  String
  equipmentId String
  equipment   Equipment @relation(fields: [equipmentId], references: [id])
  exercise    Exercise  @relation(fields: [exerciseId], references: [id])

  @@id([exerciseId, equipmentId])
}

model Muscle {
  id        String           @id @default(uuid())
  name      String           @unique
  exercises ExerciseMuscle[]
  recoveryLogs MuscleRecoveryLog[]
}

model ExerciseMuscle {
  exerciseId String
  muscleId   String
  role       MuscleRole
  exercise   Exercise @relation(fields: [exerciseId], references: [id])
  muscle     Muscle   @relation(fields: [muscleId], references: [id])

  @@id([exerciseId, muscleId, role])
  @@index([muscleId, role])
}

model Tag {
  id          String        @id @default(uuid())
  name        String        @unique
  ExerciseTag ExerciseTag[]
}

model ExerciseTag {
  exerciseId String
  tagId      String
  Exercise   Exercise @relation(fields: [exerciseId], references: [id])
  Tag        Tag      @relation(fields: [tagId], references: [id])

  @@id([exerciseId, tagId])
}

model ExerciseToAlternative {
  exerciseId                                             String
  alternativeId                                          String
  Exercise_ExerciseToAlternative_alternativeIdToExercise Exercise @relation("ExerciseToAlternative_alternativeIdToExercise", fields: [alternativeId], references: [id])
  Exercise_ExerciseToAlternative_exerciseIdToExercise    Exercise @relation("ExerciseToAlternative_exerciseIdToExercise", fields: [exerciseId], references: [id])

  @@id([exerciseId, alternativeId])
}

model WorkoutPlan {
  id          String           @id @default(uuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  goal        WorkoutGoal
  level       TrainingLevel?
  splitType   String           @default("Dynamic")
  daysPerWeek Int
  weeks       Int              @default(4)
  status      PlanStatus       @default(ACTIVE)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  sessions    WorkoutSession[]

  @@index([userId, status])
}

model WorkoutSession {
  id           String             @id @default(uuid())
  planId       String
  plan         WorkoutPlan        @relation(fields: [planId], references: [id], onDelete: Cascade)
  weekNumber   Int
  dayNumber    Int
  dayLabel     String?            
  focus        String?
  isCompleted  Boolean            @default(false)
  completedAt  DateTime?
  exercises    WorkoutExercise[]
  sessionLog   WorkoutSessionLog?

  @@index([planId, isCompleted, weekNumber, dayNumber])
}

model WorkoutExercise {
  id              String            @id @default(uuid())
  sessionId       String
  session         WorkoutSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exerciseId      String
  exercise        Exercise          @relation(fields: [exerciseId], references: [id])
  sets            Int
  reps            String
  weight          Float?
  restMin         Float?
  restMax         Float?
  order           Int
  isCompleted     Boolean           @default(false)
  performanceLogs ExercisePerformanceLog[]

  @@index([sessionId, isCompleted])
  @@index([exerciseId])
}

model ExercisePerformanceLog {
  id                String          @id @default(uuid())
  workoutExerciseId String
  workoutExercise   WorkoutExercise @relation(fields: [workoutExerciseId], references: [id], onDelete: Cascade)
  setNumber         Int
  weight            Float?
  actualReps        Int?
  rpe               Int?            
  isPersonalRecord  Boolean         @default(false)
  createdAt         DateTime        @default(now())

  @@index([workoutExerciseId, createdAt])
}

model WorkoutSessionLog {
  id                 String         @id @default(uuid())
  sessionId          String         @unique
  session            WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  durationMinutes    Int?
  perceivedDifficulty Int?           
  notes              String?
  createdAt          DateTime       @default(now())
}

model ExerciseFeedback {
  id                  String   @id @default(uuid())
  userId              String
  exerciseId          String
  preference          Preference? 
  perceivedDifficulty Int?     
  notes               String?
  updatedAt           DateTime @updatedAt

  @@unique([userId, exerciseId])
  @@index([userId, preference])
}

model MuscleRecoveryLog {
  id           String   @id @default(uuid())
  userId       String
  muscleId     String
  fatigueLevel Int      @default(0)
  lastUpdated  DateTime @default(now())
  muscle       Muscle   @relation(fields: [muscleId], references: [id])

  @@unique([userId, muscleId])
  @@index([userId])
}

model DailyRecoveryLog {
  id              String   @id @default(uuid())
  userId          String
  sleepHours      Float?
  systemicFatigue Int?    
  sorenessLevel   Int?     
  createdAt       DateTime @default(now())

  @@unique([userId, createdAt])
  @@index([userId, createdAt])
}

model BodyMetric {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date          DateTime @default(now())
  weight        Float?   
  height        Float?   
  fatPercentage Float?
  notes         String?
  
  @@unique([userId, date])
  @@index([userId, date])
}

model MetricEvent {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // e.g., WORKOUT_COMPLETE, WATER_LOG, LIFT_PR
  value     Float?
  unit      String?
  metadata  Json?    // Optional JSON for extra context (e.g., { exerciseId: "..." })
  createdAt DateTime @default(now())

  @@index([userId, type, createdAt])
}

model AnalyticsSummary {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  metricKey   String   // e.g., current_streak, weekly_tonnage, total_water
  value       Float
  metadata    Json?
  lastUpdated DateTime @default(now()) @updatedAt

  @@unique([userId, metricKey])
  @@index([userId])
}
