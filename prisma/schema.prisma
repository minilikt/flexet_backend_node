generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  password      String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  refreshTokens RefreshToken[]
  workoutPlans  WorkoutPlan[]
  
  // Profile Fields
  gender        String?
  age           Int?
  height        Float?   // cm
  weight        Float?   // kg
  goal          String?  // lose_weight, maintain, muscle_mass, strength
  trainingLevel String?  // beginner, intermediate, advanced
  activityLevel String?  // sedentary, active, etc.
  
  // Preferences & Lifestyle
  equipment     String[] // gym, home, dumbbells, etc.
  workoutDays   String[] // Monday, Tuesday, etc.
  sleepHours    Float?
  waterIntake   Float?   // liters
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Exercise {
  id                                                                  String                  @id @default(uuid())
  name                                                                String
  type                                                                String
  difficultyMin                                                       Int?
  difficultyMax                                                       Int?
  restMin                                                             Float?
  restMax                                                             Float?
  defaultSets                                                         Int?
  defaultReps                                                         String?
  loadFormula                                                         String?
  categoryId                                                          String?
  splitId                                                             String?
  movementPatternId                                                   String?
  createdAt                                                           DateTime                @default(now())
  updatedAt                                                           DateTime                @updatedAt
  externalId                                                          String?                 @unique
  category                                                            Category?               @relation(fields: [categoryId], references: [id])
  movementPattern                                                     MovementPattern?        @relation(fields: [movementPatternId], references: [id])
  split                                                               Split?                  @relation(fields: [splitId], references: [id])
  equipment                                                           ExerciseEquipment[]
  muscles                                                             ExerciseMuscle[]
  ExerciseTag                                                         ExerciseTag[]
  ExerciseToAlternative_ExerciseToAlternative_alternativeIdToExercise ExerciseToAlternative[] @relation("ExerciseToAlternative_alternativeIdToExercise")
  ExerciseToAlternative_ExerciseToAlternative_exerciseIdToExercise    ExerciseToAlternative[] @relation("ExerciseToAlternative_exerciseIdToExercise")
  workoutExercises                                                   WorkoutExercise[]
}

model Category {
  id        String     @id @default(uuid())
  name      String     @unique
  exercises Exercise[]
}

model Split {
  id        String     @id @default(uuid())
  name      String     @unique
  exercises Exercise[]
}

model MovementPattern {
  id        String     @id @default(uuid())
  name      String     @unique
  exercises Exercise[]
}

model Equipment {
  id        String              @id @default(uuid())
  name      String              @unique
  exercises ExerciseEquipment[]
}

model ExerciseEquipment {
  exerciseId  String
  equipmentId String
  equipment   Equipment @relation(fields: [equipmentId], references: [id])
  exercise    Exercise  @relation(fields: [exerciseId], references: [id])

  @@id([exerciseId, equipmentId])
}

model Muscle {
  id        String           @id @default(uuid())
  name      String           @unique
  exercises ExerciseMuscle[]
  recoveryLogs MuscleRecoveryLog[]
}

model ExerciseMuscle {
  exerciseId String
  muscleId   String
  role       String
  exercise   Exercise @relation(fields: [exerciseId], references: [id])
  muscle     Muscle   @relation(fields: [muscleId], references: [id])

  @@id([exerciseId, muscleId, role])
}

model Tag {
  id          String        @id @default(uuid())
  name        String        @unique
  ExerciseTag ExerciseTag[]
}

model ExerciseTag {
  exerciseId String
  tagId      String
  Exercise   Exercise @relation(fields: [exerciseId], references: [id])
  Tag        Tag      @relation(fields: [tagId], references: [id])

  @@id([exerciseId, tagId])
}

model ExerciseToAlternative {
  exerciseId                                             String
  alternativeId                                          String
  Exercise_ExerciseToAlternative_alternativeIdToExercise Exercise @relation("ExerciseToAlternative_alternativeIdToExercise", fields: [alternativeId], references: [id])
  Exercise_ExerciseToAlternative_exerciseIdToExercise    Exercise @relation("ExerciseToAlternative_exerciseIdToExercise", fields: [exerciseId], references: [id])

  @@id([exerciseId, alternativeId])
}
model WorkoutPlan {
  id          String           @id @default(uuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  goal        String
  level       String?
  splitType   String           @default("Dynamic")
  daysPerWeek Int
  weeks       Int              @default(4)
  status      String           @default("ACTIVE") // ACTIVE | ARCHIVED
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  sessions    WorkoutSession[]
}

model WorkoutSession {
  id           String             @id @default(uuid())
  planId       String
  plan         WorkoutPlan        @relation(fields: [planId], references: [id], onDelete: Cascade)
  weekNumber   Int
  dayNumber    Int
  focus        String?
  isCompleted  Boolean            @default(false)
  completedAt  DateTime?
  exercises    WorkoutExercise[]
  sessionLog   WorkoutSessionLog?
}

model WorkoutExercise {
  id              String            @id @default(uuid())
  sessionId       String
  session         WorkoutSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exerciseId      String
  exercise        Exercise          @relation(fields: [exerciseId], references: [id])
  sets            Int
  reps            String
  weight          Float?
  restMin         Float?
  restMax         Float?
  order           Int
  isCompleted     Boolean           @default(false)
  performanceLogs ExercisePerformanceLog[]
}

model ExercisePerformanceLog {
  id                String          @id @default(uuid())
  workoutExerciseId String
  workoutExercise   WorkoutExercise @relation(fields: [workoutExerciseId], references: [id], onDelete: Cascade)
  setNumber         Int
  weight            Float?
  actualReps        Int?
  rpe               Int?            // 1-10
  isPersonalRecord  Boolean         @default(false)
  createdAt         DateTime        @default(now())
}

model WorkoutSessionLog {
  id                 String         @id @default(uuid())
  sessionId          String         @unique
  session            WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  durationMinutes    Int?
  perceivedDifficulty Int?           // 1-10 (Soreness/Intensity)
  notes              String?
  createdAt          DateTime       @default(now())
}

model ExerciseFeedback {
  id                  String   @id @default(uuid())
  userId              String
  exerciseId          String
  preference          String?  // LIKE | DISLIKE | AVOID
  perceivedDifficulty Int?     // 1-10
  notes               String?
  updatedAt           DateTime @updatedAt

  @@unique([userId, exerciseId])
}

model MuscleRecoveryLog {
  id           String   @id @default(uuid())
  userId       String
  muscleId     String
  fatigueLevel Int      @default(0) // 0-10
  lastUpdated  DateTime @default(now())
  muscle       Muscle   @relation(fields: [muscleId], references: [id])

  @@unique([userId, muscleId])
}

model DailyRecoveryLog {
  id              String   @id @default(uuid())
  userId          String
  sleepHours      Float?
  systemicFatigue Int?    // 1-10
  sorenessLevel   Int?     // 1-10
  createdAt       DateTime @default(now())
  @@unique([userId, createdAt])
}
